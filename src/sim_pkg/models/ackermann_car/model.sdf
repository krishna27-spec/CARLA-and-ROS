<?xml version="1.0"?>
<!-- 4-wheel Ackermann car, same geometry as controls_pkg BicycleParams:
     wheelbase 0.3 m, max steer 30 deg. Model origin = rear axle centre,
     x forward. Rear wheels at x=0, front wheels at x=0.3.
     Wheel/knuckle inertias are inflated vs. real values: the plugin drives them
     with PID torques and tiny inertias make the solver blow up (all poses -> 0).
     Plugin cmd_vel: linear.x = speed [m/s], angular.z = STEERING ANGLE [rad]. -->
<sdf version="1.6">
  <model name="ackermann_car">
    <link name="base_link">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial><pose>0.15 0 0 0 0 0</pose><mass>2.0</mass>
        <inertia><ixx>0.01</ixx><iyy>0.02</iyy><izz>0.025</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><pose>0.15 0 0.02 0 0 0</pose>
        <geometry><box><size>0.42 0.14 0.05</size></box></geometry></collision>
      <visual name="body"><pose>0.15 0 0.02 0 0 0</pose>
        <geometry><box><size>0.42 0.14 0.05</size></box></geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual>
      <visual name="cabin"><pose>0.12 0 0.06 0 0 0</pose>
        <geometry><box><size>0.18 0.10 0.04</size></box></geometry>
        <material><ambient>0.9 0.9 0.95 1</ambient><diffuse>0.9 0.9 0.95 1</diffuse></material></visual>
      <visual name="nose"><pose>0.47 0 0.02 0 0 0</pose>
        <geometry><box><size>0.02 0.14 0.05</size></box></geometry>
        <material><ambient>1 0.9 0 1</ambient><diffuse>1 0.9 0 1</diffuse></material></visual>
      <visual name="lidar_visual"><pose>0.20 0 0.115 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.8 1</diffuse></material></visual>
      <sensor name="lidar" type="ray">
        <pose>0.20 0 0.12 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan><horizontal>
            <samples>360</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
          </horizontal></scan>
          <range><min>0.12</min><max>4.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="car_lidar" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=scan</remapping></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>
      <sensor name="imu" type="imu">
        <pose>0.15 0 0.03 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <plugin name="car_imu" filename="libgazebo_ros_imu_sensor.so">
          <ros><remapping>~/out:=imu</remapping></ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
          <frame_name>imu_link</frame_name>
        </plugin>
      </sensor>
      <visual name="camera_visual"><pose>0.30 0 0.075 0 0 0</pose>
        <geometry><box><size>0.03 0.05 0.03</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>
      <sensor name="camera" type="camera">
        <pose>0.31 0 0.075 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.3963</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>20</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
        </camera>
        <plugin name="car_camera" filename="libgazebo_ros_camera.so">
          <ros><namespace>camera</namespace></ros>
          <camera_name>front</camera_name>
          <frame_name>camera_link</frame_name>
        </plugin>
      </sensor>
      <sensor name="gps" type="gps">
        <pose>0.10 0 0.12 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <gps>
          <position_sensing>
            <horizontal><noise type="gaussian"><mean>0.0</mean><stddev>2e-6</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><mean>0.0</mean><stddev>0.5</stddev></noise></vertical>
          </position_sensing>
          <velocity_sensing>
            <horizontal><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><mean>0.0</mean><stddev>0.05</stddev></noise></vertical>
          </velocity_sensing>
        </gps>
        <plugin name="car_gps" filename="libgazebo_ros_gps_sensor.so">
          <ros><remapping>~/out:=gps/fix</remapping><remapping>~/vel:=gps/vel</remapping></ros>
          <frame_name>gps_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <link name="front_left_steer_link">
      <pose>0.3 0.1 0 0 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>5e-3</ixx><iyy>5e-3</iyy><izz>5e-3</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    </link>
    <joint name="front_left_steering_joint" type="revolute">
      <parent>base_link</parent><child>front_left_steer_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.5236</lower><upper>0.5236</upper></limit></axis>
    </joint>

    <link name="front_right_steer_link">
      <pose>0.3 -0.1 0 0 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>5e-3</ixx><iyy>5e-3</iyy><izz>5e-3</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    </link>
    <joint name="front_right_steering_joint" type="revolute">
      <parent>base_link</parent><child>front_right_steer_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.5236</lower><upper>0.5236</upper></limit></axis>
    </joint>

    <link name="front_left_link">
      <pose>0.3 0.1 0 0 0 0</pose>
      <inertial><mass>0.2</mass>
        <inertia><ixx>2e-3</ixx><iyy>2e-3</iyy><izz>2e-3</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steer_link</parent><child>front_left_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>

    <link name="front_right_link">
      <pose>0.3 -0.1 0 0 0 0</pose>
      <inertial><mass>0.2</mass>
        <inertia><ixx>2e-3</ixx><iyy>2e-3</iyy><izz>2e-3</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steer_link</parent><child>front_right_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>

    <link name="rear_left_link">
      <pose>0 0.1 0 0 0 0</pose>
      <inertial><mass>0.2</mass>
        <inertia><ixx>2e-3</ixx><iyy>2e-3</iyy><izz>2e-3</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>

    <link name="rear_right_link">
      <pose>0 -0.1 0 0 0 0</pose>
      <inertial><mass>0.2</mass>
        <inertia><ixx>2e-3</ixx><iyy>2e-3</iyy><izz>2e-3</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    <link name="steering_wheel_link">
      <pose>0.12 0 0.11 0 0 0</pose>
      <inertial><mass>0.02</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="visual"><geometry><cylinder><radius>0.02</radius><length>0.004</length></cylinder></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>
    </link>
    <joint name="steering_joint" type="revolute">
      <parent>base_link</parent><child>steering_wheel_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-7.85</lower><upper>7.85</upper></limit></axis>
    </joint>
    <plugin name="wheel_encoders" filename="libgazebo_ros_joint_state_publisher.so">
      <ros><remapping>~/out:=joint_states</remapping></ros>
      <update_rate>50</update_rate>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>front_left_steering_joint</joint_name>
      <joint_name>front_right_steering_joint</joint_name>
    </plugin>
    <plugin name="ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">
      <ros/>
      <update_rate>100.0</update_rate>
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <rear_left_joint>rear_left_wheel_joint</rear_left_joint>
      <rear_right_joint>rear_right_wheel_joint</rear_right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <steering_wheel_joint>steering_joint</steering_wheel_joint>
      <max_steering_angle>7.85</max_steering_angle>
      <max_steer>0.5236</max_steer>
      <max_speed>2.0</max_speed>
      <left_steering_pid_gain>2 0 0.3</left_steering_pid_gain>
      <left_steering_i_range>0 0</left_steering_i_range>
      <right_steering_pid_gain>2 0 0.3</right_steering_pid_gain>
      <right_steering_i_range>0 0</right_steering_i_range>
      <linear_velocity_pid_gain>1.5 0 0</linear_velocity_pid_gain>
      <linear_velocity_i_range>0 0</linear_velocity_i_range>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </model>
</sdf>
